{
  "include": ["src", "tests/unit", "tests/integration", "migrations"],
  "venvPath": ".",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "src",
      "extraPaths": ["src"]
    },
    {
      "root": "tests",
      "extraPaths": ["src"]
    },
    {
      "root": "migrations",
      "extraPaths": ["src"]
    }
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none"
}
