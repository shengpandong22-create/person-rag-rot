{
  "include": ["src", "tests/unit", "tests/integration", "migrations"],
  "exclude": [
    "audio.py",
    "config.py",
    "document_loader.py",
    "knowledge_base.py",
    "langgraph_rag.py",
    "main.py",
    "multi_agent_exam.py",
    "rag_engine.py",
    "voice_assistant.py",
    "tests/test_multi_agent_exam.py"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "src",
      "extraPaths": ["src"]
    },
    {
      "root": "tests",
      "extraPaths": ["src"]
    },
    {
      "root": "migrations",
      "extraPaths": ["src"]
    }
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none"
}
