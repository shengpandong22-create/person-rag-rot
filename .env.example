# Application
AGENT_MENTOR_APP_ENV=development
AGENT_MENTOR_LOG_LEVEL=INFO
AGENT_MENTOR_API_HOST=0.0.0.0
AGENT_MENTOR_API_PORT=8000

# Database
AGENT_MENTOR_DATABASE_URL=postgresql+asyncpg://agentmentor:agentmentor@db:5432/agentmentor
AGENT_MENTOR_ALEMBIC_DATABASE_URL=postgresql+psycopg://agentmentor:agentmentor@db:5432/agentmentor

# Optional OpenAI-compatible LLM configuration. Never commit real keys.
# DeepSeek example:
# AGENT_MENTOR_LLM_BASE_URL=https://api.deepseek.com/v1
# AGENT_MENTOR_LLM_DEFAULT_MODEL=deepseek-chat
AGENT_MENTOR_LLM_BASE_URL=
AGENT_MENTOR_LLM_API_KEY=
AGENT_MENTOR_LLM_DEFAULT_MODEL=
AGENT_MENTOR_EMBEDDING_MODEL=
AGENT_MENTOR_EMBEDDING_DIMENSION=1536
